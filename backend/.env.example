PORT=4000
JWT_SECRET=change_this_to_a_long_random_string

# Where the network is reachable from. 0.0.0.0 (default) accepts
# connections from other computers on your network, not just this one.
# HOST=0.0.0.0

# --- Database ---
# Local development (default): leave DATABASE_URL unset. Uses a SQLite
# file — the "data" folder is created automatically if missing.
DB_STORAGE=./data/database.sqlite

# Hosted deployment: set DATABASE_URL instead (a free Neon Postgres
# project works well — see README "Hosting"). When this is set, it's
# used automatically instead of SQLite — DB_STORAGE above is ignored.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Your organization details (used on generated PDFs)
ORG_NAME=Shoolini Life Sciences Pvt. Ltd.
ORG_WEBSITE=www.shoolinilifesciences.com
ORG_ADDRESS=Shoolini University Campus, Village - Bajhol, P.O. - Sultanpur
ORG_EMAIL=Shoolinilifescience@shooliniuniversity.com
ORG_PHONE=+91 8894987030
ORG_GST=02AAWCS9548J2ZJ

# --- PDF storage ---
# Local development (default): 'local' saves files to backend/storage/pdfs
# on this machine — folder is created automatically if missing.
STORAGE_DRIVER=local
# PDF_STORAGE_DIR=/var/data/pdfs   # only if using a mounted persistent disk

# Hosted deployment on a free host: set STORAGE_DRIVER=s3 and point it at
# a free Cloudflare R2 bucket (see README "Hosting" — no cost, no card
# needed for the free tier).
# STORAGE_DRIVER=s3
# S3_BUCKET=your-bucket-name
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key

# --- First-login bootstrap ---
# If the database has zero users (a brand new deployment), the server
# creates one admin account from these on startup. Safe to leave set
# permanently — it only fires once. Change the password after logging in.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@shoolinilifesciences.com
ADMIN_PASSWORD=change_this_password

# --- Security ---
# Once deployed, lock CORS to your actual frontend URL instead of
# allowing any origin. Comma-separate multiple URLs if needed.
# CORS_ORIGIN=https://your-app.vercel.app
